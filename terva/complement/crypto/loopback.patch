@@ -6,6 +6,8 @@ import (
 	"fmt"
 	"net"
 	"net/http"
+	"net/netip"
+	"os"
 	"strings"
 	"sync"
 	"sync/atomic"
@@ -117,7 +119,19 @@ func NewCallbackServer(t ct.TestLike, hostnameRunningComplement string) (*Callba
 	mux := http.NewServeMux()
 
 	// listen on a random high numbered port
-	ln, err := net.Listen("tcp", ":0") //nolint
+	// terva: never every interface. Under rootless podman the rig maps the
+	// host gateway to the host's loopback (HOST_LOOPBACK=1), so 127.0.0.1 is
+	// reachable from the mitmproxy container. Under Docker the gateway is the
+	// bridge's own address, which terva/complement/crypto/run.sh passes in
+	// TERVA_CALLBACK_BIND.
+	bind := os.Getenv("TERVA_CALLBACK_BIND")
+	if bind == "" {
+		bind = "127.0.0.1"
+	}
+	if addr, perr := netip.ParseAddr(bind); perr != nil || addr.IsUnspecified() {
+		return nil, fmt.Errorf("terva: TERVA_CALLBACK_BIND must be one specific address, got %q", bind)
+	}
+	ln, err := net.Listen("tcp", net.JoinHostPort(bind, "0")) //nolint
 	if err != nil {
 		return nil, fmt.Errorf("failed to listen on a tcp port: %s", err)
 	}
